      "pad-x": 16,
      "pad-x-native": 40,
      "text-pad-x": 16,
      "text-icon": 14,
      "default": 160
    },
    "$basis": {
      "公式": "档值 = ceil4(最坏内容宽 × 1.05 + 40 + 2)；40 = 数据格 px-4/tablet:px-5 在 ≥1024 时的 2×20，2 为容差余量（.scratch/table-width/01-report.md §1.1）",
      "单位": "table.* 下的数值一律按 px 生成（build-tokens.mjs 的 px 白名单含 table）；不以 px 计的常量（如字体容差 1.05）留在组件里，不进 tokens",
      "select": "44px 命中区 + px-3×2 = 68（现状 w-12=48 的内容盒只有 24，命中区越界 20）",
      "thumb": "100px 定宽缩略图 + 40 + 4 = 144",
      "date": "2026-11-10 = 61.61 → 108",
      "datetime": "2026/11/10 14:32 = 95.36；2026-11-10 ~ 至今 = 97.66 → 148",
      "count": "1,024 天 = 44.67 → 92",
      "ratio": "相对 25.00% = 67.72；黄 ±5.00pp = 64.89 → 116",
      "amount": "¥999,999,999.99 = 104.92（9 位整数）→ 156",
      "amount-extra": "104.92 + 6 + 24 = 134.92（含「负债」次标签/118px 编辑框）→ 184",
      "text-short": "1 年以上/封闭 = 74.06；固定支出+胶囊 = 64.02 → 120",
      "label": "已使用 · 1,024 行+胶囊 = 114.05；8 汉字 = 112 → 164",
      "person": "4×14 + 4 + (2×12+12) = 96.04 → 144",
      "text-mid": "金融资产 / 权益类 / 公募基金 = 177.53；示例基金沪深300ETF联接A = 168.19 → 232（唯一允许换行的文本档）",
      "note": "政策值（≈16 汉字 @14px）→ 240；asset_items.note 在 dev 库 0 条非空，唯一允许事后回调的档（spec §4.9）",
      "actions": "ceil4(Σ按钮内容宽 + gap×(n−1) + 单元格内边距 + 2)；图标按钮 44、gap 4、DataTable 单元内边距 16、原生表 40（01-report §1.2）"
    }
  },
